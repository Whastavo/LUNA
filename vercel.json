{
	"headers": [
		{
			"source": "/luna/:path*",
			"headers": [
				{
					"key": "Cache-Control",
					"value": "public, max-age=2592000, immutable"
				}
			]
		},
		{
			"source": "/:dir(blog|brand-assets)/:path*",
			"headers": [
				{
					"key": "Cache-Control",
					"value": "public, max-age=2592000, immutable"
				}
			]
		}
	],
	"rewrites": [
		{
			"source": "/",
			"has": [{ "type": "host", "value": "docs.luna.ai" }],
			"destination": "/documentacion"
		},
		{
			"source": "/:path+",
			"has": [{ "type": "host", "value": "docs.luna.ai" }],
			"destination": "/documentacion/:path+"
		},
		{
			"source": "/",
			"has": [{ "type": "host", "value": "app.luna.ai" }],
			"destination": "/app"
		}
	],
	"redirects": [
		{
			"source": "/docs",
			"has": [{ "type": "host", "value": "luna.ai" }],
			"destination": "https://docs.luna.ai",
			"permanent": true
		},
		{
			"source": "/docs/:path*",
			"has": [{ "type": "host", "value": "luna.ai" }],
			"destination": "https://docs.luna.ai/:path*",
			"permanent": true
		},
		{
			"source": "/app",
			"has": [{ "type": "host", "value": "luna.ai" }],
			"destination": "https://app.luna.ai",
			"permanent": true
		},
		{
			"source": "/app/:path*",
			"has": [{ "type": "host", "value": "luna.ai" }],
			"destination": "https://app.luna.ai/:path*",
			"permanent": true
		},
		{
			"source": "/download",
			"has": [{ "type": "host", "value": "luna.ai" }],
			"destination": "/descargar",
			"permanent": true
		},
		{
			"source": "/download/:path*",
			"has": [{ "type": "host", "value": "luna.ai" }],
			"destination": "/descargar/:path*",
			"permanent": true
		}
	]
}
