{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Luna",
  "version": "0.12.1",
  "identifier": "com.luna.app",
  "build": {
    "beforeBuildCommand": "pnpm build",
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Luna",
        "url": "/app",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      },
      {
        "label": "overlay",
        "title": "Compañera Luna",
        "url": "/overlay",
        "width": 400,
        "height": 600,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": true,
        "visible": false,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/The-Lab-by-Ordinary-Company/luna/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVFOUNENjZFQTkyOTUxM0UKUldRK1VTbXBidGFjWHVHckhFSitveFRHNHlkTmpWeXhTa3IzZWdpeVNlSDVRMVppeFVhQml2TjgK"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis", "appimage", "deb", "rpm"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Entertainment",
    "shortDescription": "Vaso del Alma de IA de Código Abierto",
    "longDescription": "Luna es un visor de avatares VRM con chat LLM y TTS. Carga modelos VRM, chatea con IA y haz que el avatar hable respuestas con sincronización de labios.",
    "macOS": {
      "minimumSystemVersion": "10.15",
      "entitlements": null,
      "signingIdentity": null
    },
    "windows": {
      "wix": null,
      "nsis": null
    }
  }
}
