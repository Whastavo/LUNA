{
  "name": "luna",
  "version": "0.12.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --host 0.0.0.0 --port 3000",
    "build": "vite build",
    "postbuild": "node -e \"const fs=require('fs'); const {execSync}=require('child_process'); if(fs.existsSync('.vercel/output/static')) execSync('npx pagefind --site .vercel/output/static', {stdio:'inherit'}); else if(fs.existsSync('build/prerendered')) execSync('npx pagefind --site build/prerendered --output-path build/client/pagefind', {stdio:'inherit'}); else if(fs.existsSync('build')) execSync('npx pagefind --site build', {stdio:'inherit'}); else console.log('Pagefind indexing skipped (no static HTML found)');\"",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "lint": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@pixiv/three-vrm": "^3.3.0",
    "@pixiv/three-vrm-animation": "^3.3.0",
    "@sveltejs/adapter-node": "^5.2.11",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-global-shortcut": "^2.3.2",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "@threlte/core": "^8.5.16",
    "@threlte/xr": "^1.6.1",
    "@xenova/transformers": "^2.17.2",
    "@xsai/stream-text": "^0.3.0",
    "bits-ui": "^1.3.1",
    "clsx": "^2.1.1",
    "dexie": "^4.0.10",
    "force-graph": "^1.51.4",
    "localforage": "^1.10.0",
    "mdsvex": "^0.12.3",
    "rehype-slug": "^6.0.0",
    "shiki": "^1.29.1",
    "svelte-i18n": "^4.0.1",
    "three": "^0.171.0"
  },
  "devDependencies": {
    "@sveltejs/adapter-auto": "^4.0.0",
    "@sveltejs/adapter-static": "^3.0.8",
    "@sveltejs/kit": "^2.15.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/force-graph": "^1.26.3",
    "@types/node": "^22.10.2",
    "@types/three": "^0.171.0",
    "autoprefixer": "^10.4.20",
    "jiti": "^2.7.0",
    "postcss": "^8.4.49",
    "prettier": "^3.4.2",
    "prettier-plugin-svelte": "^3.3.2",
    "svelte": "^5.0.0",
    "svelte-check": "^4.1.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.2",
    "vite": "^6.0.0"
  }
}
